clear;
clc;
close all;

%% Parameters

% Change this part
% Time spacing
Tmax = 2; % total time (s)
dt = 0.0001; % Time spacing (s)
n_steps = floor(Tmax / dt); % Number of steps
K_tar = 1000000; % Stiffnes constant between ghost and real mass
K_mem = 1; % Stiffness constant between mass points

% Add a perturbation force
t_per = Tmax /2; % perturbation time
per_step = t_per / dt;
per_dur = 0.05; % Perturbation duration
per_time_steps = per_dur / dt;


ratio = K_tar / K_mem; % the stiffness ratio

% Fluid Parameters
rho = 1; % density
mu = 0.01; % Kinematic Viscosity

% Driving force 
G = 2;

% Grid size
Lx = 4.0; % x length (m)
Ly = 2.0; % y length (m)
Nx = 64; % Number of grid points
Ny = Nx * Ly / Lx;

% Grid spacing 
dx = Lx / Nx;
dy = Ly / Ny;

% Forward index (fetches i+1)
ind_fx = [(2 : Nx), 1];      

% Backward index (fetches i-1)
ind_bx = [Nx, (1 : (Nx - 1))]; 

% Same for Y
ind_fy = [(2 : Ny), 1];
ind_by = [Ny, (1 : (Ny - 1))];

%% Material Parameters
Num_b = 200; % Number of grids points on boundary
Tube_ind_f = [Num_b, (1 : Num_b - 1)];
Tubd_ind_b = [(2 : Num_b), 1];

% 这里要改！！！！！！
dtheta = 2 * pi / Num_b;

% Initial Material Position
X_top = zeros(Num_b, 2); % Initialization
X_bot = X_top;

y_displace = 0.2; % Displacement from central line
% Set initial position
X_top(:, 1) = linspace(0, Lx, Num_b);
X_bot(:, 1) = X_top(:, 1);
X_top(:, 2) = Ly / 2 + y_displace;
X_bot(:, 2) = Ly / 2 - y_displace;

% We fix the start and end of the tube points. 
fix_ind = [1, Num_b];
top_fix = X_top(fix_ind, :);
bot_fix = X_bot(fix_ind, :);

% Fluid field initialization
u = zeros(Nx, Ny, 2); % In this simulation, we prescribe a total body force on the fluid. So the initial velocity is zero. 

% Driving force definition
% First two column has a force
f_drive = zeros(Nx, Ny, 2);
sigma = y_displace / 2; % Standard deviation for the Gaussian profile
for j = 1:Ny
    y = (j-1)*dy;
    if (y > Ly/2 - y_displace) && (y < Ly/2 + y_displace)
         f_drive(1:2, j, 1) = G * exp(-(y - Ly/2)^2 / (2 * sigma^2));
    end
end 

% Ghost points
Y_top = X_top;
Y_bot = X_bot;

% Animation set up
frame = 50;
sample_rate = 1 / frame / dt;
% Initialize storing
n_saved = floor(n_steps / sample_rate) + 1;


%% Force Perturbation
f_perturbation = zeros(Nx, Ny);
per_ind_y = 1 / 2 * Ny;
per_x_range = 40;
per_ind_x_start = 1 / 2 * Nx - per_x_range / 2;
per_ind_x_end = per_ind_x_start + per_x_range;
per_force = 40.0;

% Add this force to the matrix
f_perturbation(per_ind_x_start:per_ind_x_end, per_ind_y) = per_force;


